<div class="row end mb desktop-only">
    <a href="/" class="btn nowrap">Home</a>
</div>

<div class="row mb around mobile-only">
    <a href="/" class="btn nowrap" style="height: 2.2rem">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-house-door-fill" viewBox="0 0 16 16">
            <path d="M6.5 14.5v-3.505c0-.245.25-.495.5-.495h2c.25 0 .5.25.5.5v3.5a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293L8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 .5-.5"/>
        </svg>
    </a>
</div>

<div class="desktop-only overflow-x-auto">
    <table class="styled w-full w-min-40">
        <thead>
            <tr>
                <th>#</th>
                <th>Name</th>
                <th>Gender</th>
                <th>Birth</th>
                <th>Death</th>
                <th>Buriage</th>
            </tr>
        </thead>

        <tbody>
            {{ each: $people as $person }}
                <tr>
                    <td>
                        <a href="{{ route('person', id: $person->id) }}">#{{ $person->id }}</a>
                    </td>
                    <td>{{ $person->name() }}</td>
                    <td>{{ $person->gender()->label() }}</td>
                    <td>
                        {{ $person->birth_date ?: '---' }}<br />
                            in {{ $person->birth_place ?: '---' }}
                    </td>
                    <td>
                        {{ if: $person->death }}
                            {{ $person->death_date ?: '---' }}<br />
                                in {{ $person->death_place ?: '---' }}
                        {{ else: }}
                            <em>alive</em>
                        {{ if; }}
                    </td>
                    <td>
                        {{ if: $person->death }}
                            {{ $person->buriage_date ?: '---' }}<br />
                                in {{ $person->buriage_place ?: '---' }}
                        {{ else: }}
                            <em>alive</em>
                        {{ if; }}
                    </td>
                </tr>
            {{ each; }}
        </tbody>
    </table>
</div>